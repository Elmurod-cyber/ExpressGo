EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Jadvallar: supabase/expressgo.sql ni Supabase SQL Editor da bir marta ishga tushiring.

# Faqat server. Expo ilovasi buni o'qimaydi. EXPO_PUBLIC_ qilmang.
# Render/Railway uchun Supabase Connect - Session pooler.
# Foydalanuvchi postgres emas, postgres.<loyiha-ref>.
# Misol: postgresql://postgres.LOYIHA:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres
# db.<ref>.supabase.co ko'p bulutda ochilmaydi, chunki u faqat IPv6.
# Jadval: supabase/eg_delivery.sql.
DATABASE_URL=

# Bo'sh bo'lsa ilova https://expressgo.onrender.com ga qaraydi.
EXPO_PUBLIC_API_URL=

# Sinov kodi. 1 bo'lsa kod SMS emas, server xotirasida. Productionda qo'ymang.
EG_OTP_DEV=
# Eskiz SMS. Faqat serverda. EXPO_PUBLIC_ qilmang. Parol kabinet paroli emas, SMS maxfiy kaliti.
# ESKIZ_FROM bo'sh bo'lsa sinov yuboruvchisi 4546 ishlatiladi.
ESKIZ_EMAIL=
ESKIZ_SECRET=
ESKIZ_FROM=
# Ixtiyoriy o'z webhook. Eskiz to'ldirilgan bo'lsa bu ishlatilmaydi.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Administratorni server belgilar. Ilovaga yozmang. Bo'sh bo'lsa hech kim admin emas.
EG_ADMIN_PHONES=
